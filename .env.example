# Copy to .env and adjust. For OpenRouter/BYOK defaults aligned with
# observablity-platform/GodsEye, see GodsEye/.env.example and reference_runtime model_plugs.

# --- Database (Docker Compose default) ---
DATABASE_URL="postgresql://user:password@db:5432/ai_knowledge_base"

# --- Local document storage (Docker: volume mounted at /app/data/documents) ---
LOCAL_STORAGE_DIR="./data/documents"

# --- Document storage backend: local | supabase ---
# Docker / CI default: local. Deploy: set supabase + Supabase credentials below.
STORAGE_BACKEND=local
# SUPABASE_URL=https://YOUR_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=documents

# --- Supabase Postgres (deploy / demo; local Docker keeps DATABASE_URL above) ---
# Enable Database → Extensions → vector in Supabase before: alembic upgrade head
# Use direct connection (port 5432); add ?sslmode=require (postgres:// → postgresql:// if needed)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

# --- Embeddings (pgvector; 384-d matches all-MiniLM-L6-v2) ---
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIM=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- OpenRouter (RAG / LLM gateway) ---
# Same auth model as GodsEye: chat requests use OPENROUTER_API_KEY only.
# Replace with your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key

# Optional: pin one OpenRouter model id for every RAG call (overrides plug primary models).
# Leave empty so LLM_ROUTING_* plugs choose the model (recommended for auto-routing).
# Plug → model ids (see app/core/llm/model_plugs.py):
#   gemma-31b  -> google/gemma-4-31b-it:free
#   gemma-26b  -> google/gemma-4-26b-a4b-it:free
#   gpt-oss-20b -> openai/gpt-oss-20b:free
#   nemotron-nano -> nvidia/nemotron-3-nano-30b-a3b:free
# Example pin (GodsEye-style override): OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL=

# Comma-separated OpenRouter `models` failover list (model-layer rate limits / downtime).
# Example chain for gemma-26b primary (same idea as reference_runtime _STRUCTURED_FALLBACKS):
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-30b-a3b:free

# Pin routing to providers where you added BYOK in OpenRouter → Settings → Integrations.
# Do NOT put your Gemini/Google key here; OpenRouter uses the integration key.
# GodsEye default:
OPENROUTER_BYOK_PROVIDERS=google-ai-studio

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=120

DEFAULT_LLM_PROVIDER=openrouter

# Auto-routing LLM gateway (plug names: gemma-26b, gemma-31b, gpt-oss-20b, nemotron-nano)
LLM_ROUTING_DEFAULT_PLUG=gemma-26b
LLM_ROUTING_QUALITY_PLUG=gemma-31b
LLM_ROUTING_FAST_PLUG=gemma-26b
# Min cosine-style similarity (1 - pgvector distance) for "strong" retrieval routing (not RRF score)
LLM_ROUTING_STRONG_SIMILARITY_THRESHOLD=0.35
# QUERY_HISTORY_RETENTION_DAYS=0

# --- Auth (JWT for API / frontend) ---
SECRET_KEY=change-me-in-production

# --- Demo / portfolio (hosted Try demo; you upload via password login locally) ---
# DEMO_LOGIN_ENABLED=true
# DEMO_USERNAME=demo
# ALLOW_PUBLIC_REGISTRATION=false
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=set-when-running-seed_demo_user-only-not-for-hosted-env

# --- OpenTelemetry (Docker Compose only; never enable on Render) ---
# OTEL_TRACES_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=fastapi-app

# --- CORS (comma-separated; add your deployed frontend origin) ---
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://your-frontend.example.com

# --- Evaluations (optional) ---
# EVALUATION_DATASET_PATH=../evals/dataset/dataset.json
# EVALUATION_BASELINE_PATH=../evals/baseline/results.json
